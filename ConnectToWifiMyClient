#connect to local python 3
import socket
import time

serverAddress = ('192.168.1.142', 2222)
bufferSize = 1024

UDPClient = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
UDPClient.settimeout(1)

while True:
    cmd = input("ENTER YOUR MESSAGE: ")
    cmdEncoded = cmd.encode("utf-8")
    UDPClient.sendto(cmdEncoded, serverAddress)

    try:
        data, address = UDPClient.recvfrom(bufferSize)
        print("MESSAGE FROM SERVER:", data.decode("utf-8"))
    except socket.timeout:
        print("No reply from server.")

    time.sleep(0.1)
